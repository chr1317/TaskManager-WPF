<Window
    x:Class="TaskManagerWpfApp.Views.FilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Filtruj zadania"
    Background="White"
    FontFamily="Segoe UI"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <Border
        Margin="20"
        Padding="20"
        Background="White"
        CornerRadius="12">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Bold"
                Text="Filtruj zadania" />

            <TextBlock Margin="0,0,0,5" Text="Kategoria" />
            <ComboBox
                Height="30"
                Margin="0,0,0,15"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}" />

            <TextBlock Margin="0,0,0,5" Text="Priorytet" />
            <ComboBox
                Height="30"
                Margin="0,0,0,15"
                ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding SelectedPriority}" />

            <TextBlock Margin="0,0,0,5" Text="Termin końcowy" />
            <DatePicker
                Height="30"
                Margin="0,0,0,20"
                SelectedDate="{Binding SelectedEndDate}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Border
                    Width="100"
                    Height="34"
                    Margin="0,0,10,0"
                    Background="#757575"
                    CornerRadius="6">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Clear_Click"
                        Content="Wyczyść"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>
                <Border
                    Width="80"
                    Height="34"
                    Margin="0,0,10,0"
                    Background="#E53935"
                    CornerRadius="6">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Cancel_Click"
                        Content="Anuluj"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>

                <Border
                    Width="80"
                    Height="34"
                    Background="#4CAF50"
                    CornerRadius="6">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Apply_Click"
                        Content="Zastosuj"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
