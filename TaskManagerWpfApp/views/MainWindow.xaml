<Window
    x:Class="TaskManagerWpfApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:TaskManagerWpfApp.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Task Manager"
    Width="900"
    Height="680"
    Background="#f5f5f5"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <helpers:TaskStatusToBoolConverter x:Key="TaskStatusToBoolConverter" />
        <helpers:StatusToIconConverter x:Key="StatusToIconConverter" />
        <helpers:StatusToColorConverter x:Key="StatusToColorConverter" />
    </Window.Resources>


    <DockPanel>
        <!--  Menu na górze  -->
        <Menu Background="#E0E0E0" DockPanel.Dock="Top">
            <MenuItem Header="Konto">
                <MenuItem Command="{Binding LogoutCommand}" Header="Wyloguj" />
            </MenuItem>
        </Menu>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360*" />
                <!--  Lista zadań  -->
                <ColumnDefinition Width="313*" />
                <ColumnDefinition Width="227*" />
                <!--  Szczegóły zadania  -->
            </Grid.ColumnDefinitions>

            <!--  Lewy panel  -->
            <ScrollViewer Grid.Column="0" Background="#F8F8F8">
                <StackPanel Margin="15">

                    <!--  Górne przyciski  -->
                    <UniformGrid
                        Height="auto"
                        Margin="0,0,0,20"
                        Columns="5"
                        Rows="1">
                        <Border
                            Margin="5"
                            Background="#4CAF50"
                            CornerRadius="6">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding AddTaskCommand}"
                                Content="➕"
                                Cursor="Hand"
                                FontSize="18"
                                Foreground="White" />
                        </Border>

                        <Border
                            Margin="5"
                            Background="#B2DFDB"
                            CornerRadius="6">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleFilterPanelCommand}"
                                Content=""
                                Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="#00695C"
                                ToolTip="Filtruj" />
                        </Border>

                        <Border
                            Margin="5"
                            Background="#DCEDC8"
                            CornerRadius="6">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding SortTasksCommand}"
                                Content=""
                                Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="#558B2F"
                                ToolTip="Sortuj" />
                        </Border>

                        <Border
                            Margin="5"
                            Background="#E53935"
                            CornerRadius="6">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding DataContext.SelectedTask, RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="🗑"
                                Cursor="Hand"
                                FontSize="18"
                                Foreground="White" />
                        </Border>

                        <Border
                            Margin="5"
                            Background="#BBDEFB"
                            CornerRadius="6">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ShowStatisticsCommand}"
                                Content="📊"
                                Cursor="Hand"
                                FontSize="18"
                                Foreground="#1565C0"
                                ToolTip="Statystyki" />
                        </Border>
                    </UniformGrid>


                    <!--  Wyszukiwarka  -->
                    <StackPanel
                        Margin="0,0,0,20"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="310"
                            Height="40"
                            Padding="4"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="6"
                                    Opacity="0.2"
                                    ShadowDepth="1" />
                            </Border.Effect>
                            <DockPanel>
                                <TextBox
                                    x:Name="SearchBox"
                                    Width="250"
                                    Padding="4,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    Width="30"
                                    Height="30"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding SearchCommand}"
                                    Content=""
                                    Cursor="Hand"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Foreground="#00796B"
                                    ToolTip="Szukaj" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!--  Lista zadań  -->
                    <TreeView ItemsSource="{Binding Tasks}" SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Subtasks}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="14"
                                        Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                        Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>


                </StackPanel>
            </ScrollViewer>

            <!--  Prawy panel  -->
            <Border
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="25,25,25,25"
                Padding="25"
                Background="White"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.3"
                        ShadowDepth="2" />
                </Border.Effect>

                <StackPanel>

                    <DockPanel Margin="5,0,0,20" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="Szczegóły zadania" />

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                Width="32"
                                Height="32"
                                Margin="0,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding EditTaskCommand}"
                                Content=""
                                Cursor="Hand"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="Black"
                                ToolTip="Edytuj"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>


                    <TextBlock Margin="5,0,0,5" Text="Tytuł zadania" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        IsReadOnly="{Binding IsReadOnlyMode}"
                        Text="{Binding SelectedTask.Title}" />

                    <TextBlock Margin="5,0,0,5" Text="Termin wykonania" />
                    <DatePicker
                        Margin="0,0,0,15"
                        Focusable="{Binding IsEditing}"
                        IsHitTestVisible="{Binding IsEditing}"
                        SelectedDate="{Binding SelectedTask.EndDate}" />


                    <TextBlock Margin="5,0,0,5" Text="Kategoria" />
                    <ComboBox
                        Margin="0,0,0,15"
                        DisplayMemberPath="Name"
                        IsEnabled="{Binding IsEditing}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedTask.Category}" />


                    <TextBlock Margin="5,0,0,5" Text="Priorytet" />
                    <ComboBox
                        Margin="0,0,0,15"
                        IsEnabled="{Binding IsEditing}"
                        ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding SelectedTask.Priority}" />

                    <CheckBox
                        Margin="0,0,0,15"
                        Content="Zadanie wykonane"
                        IsChecked="{Binding IsTaskCompleted, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditing}" />


                    <TextBlock Margin="5,0,0,5" Text="Opis zadania" />
                    <Grid Height="100" Margin="0,0,0,15">
                        <TextBox
                            x:Name="DescriptionBox"
                            Padding="5"
                            AcceptsReturn="True"
                            BorderBrush="#CCC"
                            IsReadOnly="{Binding IsReadOnlyMode}"
                            Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <TextBlock
                            Margin="10,6,0,0"
                            VerticalAlignment="Top"
                            Foreground="Gray"
                            IsHitTestVisible="False"
                            Text="Opis zadania"
                            Visibility="{Binding Text, ElementName=DescriptionBox, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                        <Border
                            Width="140"
                            Height="40"
                            Margin="0,0,200,0"
                            Background="#0288D1"
                            CornerRadius="6"
                            Visibility="{Binding CanAddSubtask, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button
                                Height="34"
                                Margin="0,3,0,3"
                                Padding="15,0"
                                Background="#0288D1"
                                BorderBrush="{x:Null}"
                                Command="{Binding AddSubtask}"
                                Content="Dodaj podzadanie"
                                Cursor="Hand"
                                Foreground="White" />
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Border
                            Width="90"
                            Height="40"
                            Margin="0,10,10,0"
                            Background="#4CAF50"
                            CornerRadius="6"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button
                                Height="34"
                                Padding="25,0"
                                Background="#4CAF50"
                                BorderBrush="{x:Null}"
                                Command="{Binding SaveTaskCommand}"
                                Content="Zapisz"
                                Cursor="Hand"
                                Foreground="White" />
                        </Border>

                        <Border
                            Width="90"
                            Height="40"
                            Margin="10,10,0,0"
                            Background="#E53935"
                            CornerRadius="6"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button
                                Height="34"
                                Padding="20,0"
                                Background="#E53935"
                                BorderBrush="{x:Null}"
                                Command="{Binding CancelEditCommand}"
                                Content="Anuluj"
                                Cursor="Hand"
                                Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
