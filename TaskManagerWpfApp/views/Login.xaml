<Window x:Class="TaskManagerWpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie"
        Height="280"
        Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nazwa użytkownika:" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Height="30"/>

        <TextBlock Text="Hasło:" Grid.Row="2" Margin="10,10,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="30"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Zaloguj się"
                    Width="100"
                    Click="Login_Click"/>
        </StackPanel>
        <TextBlock Text="Nie masz konta? Zarejestruj się" Grid.Row="5" TextAlignment="Center" Margin="0,20,0,10"/>
        <Button Content="Zarejestruj się"
                    Width="110"
                    Margin="100,10,110,-10"
                    Click="Register_Click"
                Grid.Row="6"/>
    </Grid>
</Window>
