<Window x:Class="TaskManagerWpfApp.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja" Height="250" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nazwa użytkownika:" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Height="30"/>

        <TextBlock Text="Hasło:" Grid.Row="2" Margin="0,10,0,0"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="30" Margin="0,2,0,33"/>

        <Button Content="Zarejestruj"
                Width="100"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,48,0,0"
                Grid.Row="3"
                Click="Register_Click"/>
    </Grid>
</Window>
