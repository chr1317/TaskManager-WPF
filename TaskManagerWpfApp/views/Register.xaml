<Window x:Class="TaskManagerWpfApp.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja"
        Height="280"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f5f5f5"
        FontFamily="Segoe UI">

    <Border CornerRadius="10"
            Padding="15"
            Background="White"
            Margin="10"
            BorderBrush="#DDD"
            BorderThickness="1">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">

            <TextBlock Text="Rejestracja"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Nazwa użytkownika" Margin="0,0,0,3"/>
            <TextBox x:Name="UsernameBox" Height="26" Padding="5" Margin="0,0,0,8"/>

            <TextBlock Text="Hasło" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Height="26" Padding="5" Margin="0,0,0,15"/>

            <Border CornerRadius="6" Background="#0078D7" Height="34" Margin="0,0,0,0">
                <Button Content="Zarejestruj"
                        Click="Register_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </Border>
            <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12">
                <Run Text="Masz już konto? "/>
                <Hyperlink Click="Login_Click" Foreground="#0078D7" Cursor="Hand" TextDecorations="None">
                    Zaloguj się teraz
                </Hyperlink>
            </TextBlock>


        </StackPanel>
    </Border>
</Window>
