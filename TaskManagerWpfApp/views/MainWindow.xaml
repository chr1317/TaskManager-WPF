<Window x:Class="TaskManagerWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Lista zadań -->
            <ColumnDefinition Width="3*"/>
            <!-- Szczegóły zadania -->
        </Grid.ColumnDefinitions>

        <!-- Lewa kolumna - lista zadań -->
        <ScrollViewer Grid.Column="0" Background="#F8F8F8">
            <StackPanel Margin="10">
                <!-- Pasek przycisków -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10" VerticalAlignment="Center">
                    <!-- Dodaj -->
                    <Button Content="➕ Dodaj"
                Command="{Binding AddTaskCommand}"
                Width="80" Margin="0,0,0,0"
                            Background="#2E7D32"/>

                    <!-- Filtruj -->
                    <Button Content="🧹 Filtruj"
                Command="{Binding ToggleFilterPanelCommand}"
                Width="80" Margin="0,0,0,0"
                            Background="#455A64"/>

                    <!-- Sortuj -->
                    <Button Content="🔃 Sortuj"
                Command="{Binding ToggleSortPanelCommand}"
                Width="80" Margin="0,0,0,0"
                            Background="#546E7A"/>

                    <!-- Szukaj -->
                    <Button Content="🔍"
                Command="{Binding ToggleSearchBarCommand}"
                Width="40"
                            Background="#CFD8DC"/>
                </StackPanel>

                <!-- Wyszukiwarka (pokazywana po kliknięciu lupki) -->
                <TextBox Height="30"
             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"
             Width="200"
             Margin="0,0,0,10"/>
                <TreeView>
                    <TreeViewItem Header="Employee1">
                        <TreeViewItem Header="Jesper"/>
                        <TreeViewItem Header="Aaberg"/>
                        <TreeViewItem Header="12345"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Employee2">
                        <TreeViewItem Header="Dominik"/>
                        <TreeViewItem Header="Paiha"/>
                        <TreeViewItem Header="98765"/>
                    </TreeViewItem>
                </TreeView>
                <!-- Lista zadań -->
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="False" Margin="0,5">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SubTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsCompleted}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Szczegóły"
                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        
        </ScrollViewer>

        <!-- Prawa kolumna - szczegóły zadania -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Szczegóły zadania" FontSize="16" FontWeight="Bold" Margin="5,0,0,10"/>

            <TextBlock Text="Tytuł zadania" Margin="5,0,0,0" />
            <TextBox Text="{Binding SelectedTask.Title}" Margin="5,0,5,10"/>

            <DatePicker SelectedDate="{Binding SelectedTask.DueDate}" Margin="5,0,5,10"/>
            <TextBlock Text="Wybierz kategorię" Margin="5,10,0,2" />
            <ComboBox ItemsSource="{Binding Categories}"
          SelectedItem="{Binding SelectedTask.Category}"
          Margin="5,0,5,0" />
            <TextBlock Text="Ustal piorytet" Margin="5,10,0,2"/>
            <ComboBox ItemsSource="{Binding Priorities}"
                      SelectedItem="{Binding SelectedTask.Priority}"
                      Margin="5,0,5,10"/>

            <Grid Margin="5,0,5,0" Height="100">
                <TextBox x:Name="DescriptionBox"
             Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap" />

                <TextBlock Text="Opis zadania"
               Foreground="Gray"
               Margin="8,6,0,0"
               Padding="2"
               IsHitTestVisible="False"
               VerticalAlignment="Top"
               Visibility="{Binding Text.IsEmpty, ElementName=DescriptionBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
            <Button Content="Dodaj podzadanie" Command="{Binding AddSubtask}" Margin=" 5,10,5,0" />

            <Button Content="Zapisz" Command="{Binding SaveTaskCommand}" Margin="5,10,5,0"/>
        </StackPanel>
    </Grid>

</Window>
